{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Timeshit repository page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generation",
    "selectionRevision",
    "repositories",
    "page",
    "hasNext"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "generation": {
      "type": "string",
      "format": "uuid"
    },
    "selectionRevision": {
      "type": "string",
      "format": "uuid"
    },
    "repositories": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "name",
          "description",
          "private",
          "archived",
          "defaultBranch",
          "access",
          "checkedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,38}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{1,100}$"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "private": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          },
          "defaultBranch": {
            "type": [
              "string",
              "null"
            ]
          },
          "access": {
            "enum": [
              "not-checked",
              "readable",
              "unavailable"
            ]
          },
          "checkedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "hasNext": {
      "type": "boolean"
    }
  }
}
