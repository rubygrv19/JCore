# Set real values in the ignored local .env file or your deployment secret manager.
NUXT_AUTH_ADMIN_EMAIL=
NUXT_AUTH_ADMIN_PASSWORD=
# Exact application origin, without a trailing slash. Required in production.
NUXT_AUTH_TRUSTED_ORIGIN=http://127.0.0.1:3000
# Optional exact proxy peer IPs, comma-separated. Empty ignores forwarded IP headers.
# Enable only after the proxy overwrites X-Real-IP and direct access is restricted.
NUXT_AUTH_TRUSTED_PROXY_IPS=

# Required in production: use a unique random secret with at least 32 characters.
NUXT_SESSION_PASSWORD=

# Private host-local collector. Never expose Prometheus or Node Exporter publicly.
NUXT_VPS_PROMETHEUS_URL=http://127.0.0.1:9090
# Explicit expectations only. Example: {"your-app.service":"active"}
# Empty means that expected states are unknown; failed units still report Critical.
NUXT_VPS_EXPECTED_SERVICES={}

# Timeshit server-only configuration. Generate a stable, private 32-byte base64 key.
NUXT_TIMESHIT_ENCRYPTION_KEY=
# Exact browser origin; no trailing slash. Use your HTTPS origin when deploying.
NUXT_TIMESHIT_TRUSTED_ORIGIN=http://127.0.0.1:3000
# Optional absolute private path; defaults to .data/timeshit.sqlite under runtime cwd.
NUXT_TIMESHIT_DATABASE_PATH=
