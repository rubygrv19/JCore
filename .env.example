# Set real values in the ignored local .env file or your deployment secret manager.
NUXT_AUTH_ADMIN_EMAIL=
NUXT_AUTH_ADMIN_PASSWORD=

# Required in production: use a unique random secret with at least 32 characters.
NUXT_SESSION_PASSWORD=

# Private host-local collector. Never expose Prometheus or Node Exporter publicly.
NUXT_VPS_PROMETHEUS_URL=http://127.0.0.1:9090
# Explicit expectations only. Example: {"your-app.service":"active"}
# Empty means that expected states are unknown; failed units still report Critical.
NUXT_VPS_EXPECTED_SERVICES={}
